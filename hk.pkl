amends "package://github.com/jdx/hk/releases/download/v1.39.0/hk@1.39.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    ["ruff"] = new Step {
        glob = List("**/*.py")
        check = "ruff check {{files}}"
        fix = "ruff check --fix {{files}}"
    }
    ["ruff-format"] = new Step {
        glob = List("**/*.py")
        check = "ruff format --check {{files}}"
        fix = "ruff format {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "patch-file"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
